# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the key. `.env` is git-ignored.
# Never commit real credentials.
# ---------------------------------------------------------------------------

# --- chat model (OpenAI-compatible endpoint) -------------------------------
# Provider presets: deepseek (default), openai, openai-compatible.
# LLM_BASE_URL / LLM_MODEL always win, so any compatible vendor works.
LLM_PROVIDER=deepseek
LLM_API_KEY=
# DeepSeek key can also be provided as DEEPSEEK_API_KEY=sk-...
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
# function_calling is the most widely supported structured-output mode;
# switch to json_schema if your endpoint supports strict JSON schema.
STRUCTURED_OUTPUT_METHOD=function_calling

# --- embeddings ------------------------------------------------------------
# local = deterministic offline hashing embeddings (no key, default).
# DeepSeek has no embeddings API, so `local` keeps a DeepSeek-only setup runnable.
EMBEDDING_PROVIDER=local
EMBEDDING_DIM=512
# To use an OpenAI-compatible embeddings endpoint instead:
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=

# --- RAG -------------------------------------------------------------------
RAG_TOP_K=6
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=150
RAG_MAX_INDEX_FILES=400

# --- tools / agent ---------------------------------------------------------
MAX_FILE_BYTES=512000
MAX_READ_LINES=400
MAX_SEARCH_RESULTS=20
AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_ITERATIONS=6
AGENT_MEMORY_TURNS=6
AGENT_REQUIRE_EVIDENCE=1

# --- default repository ----------------------------------------------------
# REPO_ROOT=.
